# Copy to .env.local and fill values. Do not commit credentials.
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://hpp:CHANGE_ME@127.0.0.1:5432/hpp
AUTH_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# Stable source and stable product IDs agreed with the sender, not product names.
PURCHASE_SOURCE_ID=your-purchase-source
PURCHASE_WEBHOOK_KEYS={"primary":{"source":"your-purchase-source","secret":"CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_SECRET"}}
ELIGIBLE_AI_FOOD_PRODUCT_IDS=your-stable-product-id
EMAIL_FROM="HPP Kuliner <noreply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# For Brevo port 587, require STARTTLS; do not set SMTP_SECURE=true.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_CONTACT_URL=https://example.com/support
