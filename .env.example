# Copy to .env.local and fill values. Do not commit credentials.
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://hpp:CHANGE_ME@127.0.0.1:5432/hpp
AUTH_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# Stable source and stable product IDs agreed with the sender, not product names.
PURCHASE_SOURCE_ID=your-purchase-source
PURCHASE_WEBHOOK_KEYS={"primary":{"source":"your-purchase-source","secret":"CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_SECRET"}}
ELIGIBLE_AI_FOOD_PRODUCT_IDS=your-stable-product-id
# Use the same product ID for both features when checkout sells one KulinerKit bundle.
PROMPT_GALLERY_PRODUCT_IDS=your-stable-product-id
# Private prompt images. Do not put paid content under public/.
# Use a persistent absolute path outside release directories in production.
PROMPT_MEDIA_ROOT=.data/prompt-gallery
# Private QRIS images. Use a persistent path outside release directories in production.
CHECKOUT_MEDIA_ROOT=.data/checkout
EMAIL_FROM="HPP Kuliner <noreply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# For Brevo port 587, require STARTTLS; do not set SMTP_SECURE=true.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_CONTACT_URL=https://example.com/support
# Legacy/bootstrap fallback only. Configure Meta from /admin/meta after migration.
# Database admin settings override these values. Use a dataset separate from LRMobileID.
META_TRACKING_ENABLED=false
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
# Test Events fallback only; clear before live reporting.
META_TEST_EVENT_CODE=
# Optional admin-only Web Push for new direct-checkout orders. Generate one VAPID pair,
# keep the private key on the server, and use a real public contact (not localhost).
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com
